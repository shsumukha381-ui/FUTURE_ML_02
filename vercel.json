{
  "functions": {
    "api/index.py": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/health", "destination": "/api/index.py" },
    { "source": "/api/model-info", "destination": "/api/index.py" },
    { "source": "/api/predict", "destination": "/api/index.py" },
    { "source": "/api/predict/batch", "destination": "/api/index.py" },
    { "source": "/api/docs", "destination": "/api/index.py" },
    { "source": "/api/openapi.json", "destination": "/api/index.py" },
    { "source": "/(.*)", "destination": "/frontend/$1" }
  ]
}
